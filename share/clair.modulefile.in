#%Module1.0
#
# To be installed as ${MODULEPATH}/clair/@PROJECT_VERSION@

set     name        clair
set     version     @PROJECT_VERSION@
set     root        @CMAKE_INSTALL_PREFIX@
set     git_hash    @PROJECT_GIT_HASH@

set     url         "https://github.com/flatironinstitute/clair"
set     description "Clair (Clang Introspection and Reflection) tools. A set of clang tools developed for Flatiron/CCQ"

module-whatis   "$description"

proc ModulesHelp { } {
    global description url version git_hash
    puts stderr "Description: $description"
    puts stderr "URL:         $url"
    puts stderr "Version:     $version"
    puts stderr "Git hash:    $git_hash"
}

# Only one version of clair can be loaded at a time
conflict $name

setenv          CLAIR_ROOT         $root
setenv          CLAIR_VERSION      $version
setenv          CLAIR_GIT_HASH     $git_hash

prepend-path    PATH                @CMAKE_INSTALL_FULL_BINDIR@
prepend-path    CPLUS_INCLUDE_PATH  @CMAKE_INSTALL_FULL_INCLUDEDIR@
prepend-path    LIBRARY_PATH        @CMAKE_INSTALL_FULL_LIBDIR@
prepend-path    PYTHONPATH          $root/@PYTHON_LIB_DEST_ROOT@
prepend-path    CMAKE_PREFIX_PATH   @CMAKE_INSTALL_FULL_LIBDIR@/cmake/clair
